# Copy this file to `.env` for local development. Never commit the
# real `.env` file. In production (Cloud Run) these are set as
# environment variables / secrets on the service instead of a file —
# see the Deploy section in README.md.

# Cloud SQL instance connection name: project:region:instance
INSTANCE_CONNECTION_NAME=

# Database user.
DB_USER=

# Database password. Leave empty when DB_IAM_AUTH=true.
DB_PASS=

DB_NAME=postgres

# Set to "true" to authenticate with Automatic IAM Database
# Authentication instead of a password (recommended on Cloud Run: the
# service's own account is granted a Cloud SQL IAM user, so there is no
# DB password to store or rotate at all).
DB_IAM_AUTH=false

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=https://analor.com.br,http://localhost:5173
